{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "doc2md",
  "version": "1.0.0",
  "identifier": "com.doc2md.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "doc2md — 문서를 마크다운으로",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 580,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "doc2md",
    "category": "Productivity",
    "shortDescription": "문서를 마크다운으로 일괄 변환",
    "longDescription": "HWP, HWPX, PDF, DOCX, XLSX, PPTX 문서를 마크다운(.md)으로 일괄 변환합니다.",
    "externalBin": ["binaries/converter-engine"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "languages": ["Korean", "English"], "displayLanguageSelector": false }
    }
  }
}
